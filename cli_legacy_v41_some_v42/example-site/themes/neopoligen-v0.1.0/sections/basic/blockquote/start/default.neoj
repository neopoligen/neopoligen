[! import "includes/theme.neoj" as theme !]
<section 
    [@- theme.section_classes(section, "blockquote-section flow") -@] 
    [@- section.attr_string -@]>
<blockquote class="flow">
[! include "subsections/content-all-blocks.neoj" !]
[! if "by" in section.attrs !]
<div class="blockquote-by">-- [@ theme.output_spans(site, page_id, section.attr_spans.by) @]</div>
[! endif !]
</blockquote>

[! include "subsections/end-section.neoj" !]
