-- title

Emphasis Shorthand Spec Tests

-- neopoligen-spec-test/

{
  "version": "0.42.0",
  "name": "Valid Emphasis Shorthand Spans",
  "notes": [
    "This is just getting started, there are more to test that I'll add in the next iteration",
    "The invalid cases aren't exhaustive (i.e. they don't test every possible character that's not allowed). They're just meant to be representative",
    "This is the first version of the parse and only deals with English. I'm working on figuring out how to do other character sets", 
  ],
  "tests": {
    "todo_valid": [
    ],
    "todo_invalid": [
    ],
    "valid": [
      {
        "description": "Basic tag",
        "source": "__alfa__",
        "result": '{ "attrs": {}, "flags": [], "text": "alfa", "type": "emphasis_shorthand"}',
        "notes": [],
      },
      {
        "description": "Can have any content other than unescaped pipes or unescaped underscores",
        "source": "__alfa ~!@#$ <html> <<named-span>>__",
        "result": '{ "attrs": {}, "flags": [], "text": "alfa ~!@#$ <html> <<named-span>>", "type": "emphasis_shorthand"}',
        "notes": [],
      },
      {
        "description": "Can have flags",
        "source": "__alfa|bravo__",
        "result": '{ "attrs": {}, "flags": ["bravo"], "text": "alfa", "type": "emphasis_shorthand"}',
        "notes": [],
      },
      {
        "description": "Flags can have any content besides unescaped pipes, unescaped underscores, and unescaped escapes",
        "source": "__alfa|bravo ~!@# : __",
        "result": '{ "attrs": {}, "flags": ["bravo ~!@# : "], "text": "alfa", "type": "emphasis_shorthand"}',
        "notes": [
          "Note colons followed by whitespace are allowed since key values will have already been parsed based on the intentional order of operation in the parser"
        ],
      },
      {
        "description": "Flags can have escaped pipes",
        "source": "__alfa|bravo \\| charlie__",
        "result": '{ "attrs": {}, "flags": ["bravo | charlie"], "text": "alfa", "type": "emphasis_shorthand"}',
        "notes": [],
      },
      {
        "description": "Flags can have escaped underscores",
        "source": "__alfa|bravo \\_ charlie__",
        "result": '{ "attrs": {}, "flags": ["bravo _ charlie"], "text": "alfa", "type": "emphasis_shorthand"}',
        "notes": [],
      },
      {
        "description": "Flags can have single underscores",
        "source": "__alfa|bravo _ charlie__",
        "result": '{ "attrs": {}, "flags": ["bravo _ charlie"], "text": "alfa", "type": "emphasis_shorthand"}',
        "notes": [],
      },
      {
        "description": "Key/value attrs are allowed",
        "source": "__alfa|bravo: charlie__",
        "result": '{ "attrs": {"bravo": [{"text": "charlie", "type": "plain_text"}]}, "flags": [], "text": "alfa", "type": "emphasis_shorthand"}',
        "notes": [],
      },
      {
        "description": "Key/value keys can have numbers",
        "source": "__alfa|bravo1: charlie__",
        "result": '{ "attrs": {"bravo1": [{"text": "charlie", "type": "plain_text"}]}, "flags": [], "text": "alfa", "type": "emphasis_shorthand"}',
        "notes": [],
      },
      {
        "description": "Key/value keys can have hyphens",
        "source": "__alfa|bravo--charlie: delta__",
        "result": '{ "attrs": {"bravo--charlie": [{"text": "delta", "type": "plain_text"}]}, "flags": [], "text": "alfa", "type": "emphasis_shorthand"}',
        "notes": [],
      },
      {
        "description": "Key/value keys can have underscores",
        "source": "__alfa|bravo__charlie: delta__",
        "result": '{ "attrs": {"bravo__charlie": [{"text": "delta", "type": "plain_text"}]}, "flags": [], "text": "alfa", "type": "emphasis_shorthand"}',
        "notes": [],
      },
      {
        "description": "Key/value values can be anything other than unescaped pipes, unescaped double underscores, or unescaped escapes",
        "source": "__alfa|bravo: charlie ~!@# <html> <<named-span>>__",
        "result": '{ "attrs": {"bravo": [{"text": "charlie ~!@# <html> <<named-span>>", "type": "plain_text"}]}, "flags": [], "text": "alfa", "type": "emphasis_shorthand"}',
        "notes": [],
      },
      {
        "description": "Key/value values can have single underscores",
        "source": "__alfa|bravo: charlie _ delta__",
        "result": '{ "attrs": {"bravo": [{"text": "charlie ", "type": "plain_text"}, {"text": "_", "type": "plain_text"}, {"text": " delta", "type": "plain_text"}]}, "flags": [], "text": "alfa", "type": "emphasis_shorthand"}',
        "notes": [],
      },
      {
        "description": "Key/value values can have escaped underscores",
        "source": "__alfa|bravo: charlie \\__ delta__",
        "result": '{ "attrs": {"bravo": [{"text": "charlie ", "type": "plain_text"}, {"text": "_", "type": "escaped_character" }, {"text": "_", "type": "plain_text"}, {"text": " delta", "type": "plain_text"}]}, "flags": [], "text": "alfa", "type": "emphasis_shorthand"}',
        "notes": [],
      },
      {
        "description": "Key/value values can have escaped pipes",
        "source": "__alfa|bravo: charlie \\| delta__",
        "result": '{ "attrs": {"bravo": [{"text": "charlie ", "type": "plain_text"}, {"text": "|", "type": "escaped_character" }, {"text": " delta", "type": "plain_text"}]}, "flags": [], "text": "alfa", "type": "emphasis_shorthand"}',
        "notes": [],
      },
      {
        "description": "Key/value values can have escaped escapes",
        "source": "__alfa|bravo: charlie \\\\ delta__",
        "result": '{ "attrs": {"bravo": [{"text": "charlie ", "type": "plain_text"}, {"text": "\\\\", "type": "escaped_character" }, {"text": " delta", "type": "plain_text"}]}, "flags": [], "text": "alfa", "type": "emphasis_shorthand"}',
        "notes": ["Note: I'm not sure this one renders correctly in the output based of the loop I'm testing with. It should just be a single backslash for the text"],
      },
    ],
    "invalid": [
      {
        "description": "Can't end with an unescaped pipe",
        "source": "__alfa|__",
        "notes": [],
      },
    ],
  },
}

-- /neopoligen-spec-test


