-- title

Valid Named Spans

-- neopoligen-spec-test/

{
  "version": "0.42.0",
  "name": "Valid Named Spans",
  "notes": [
    "This is just getting started, there are more to test that I'll add in the next iteration",
    "The invalid cases aren't exhaustive (i.e. they don't test every possible character that's not allowed). They're just meant to be representative",
  ],
  "tests": {
    "todo_valid": [
    ],
    "todo_invalid": [
    ],

    "valid": [
      {
        "description": "basic text",
        "source": "<<alfa>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa", "spans": null, "text": null, "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "names can have numbers",
        "source": "<<alfa1>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa1", "spans": null, "text": null, "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "names can have hyphens",
        "source": "<<alfa-bravo>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa-bravo", "spans": null, "text": null, "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "names can have multiple hyphens",
        "source": "<<alfa--bravo>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa--bravo", "spans": null, "text": null, "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "names can have underscores",
        "source": "<<alfa_bravo>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa_bravo", "spans": null, "text": null, "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "names can have multiple underscores",
        "source": "<<alfa__bravo>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa__bravo", "spans": null, "text": null, "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "there can be leading spaces",
        "source": "<< alfa>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa", "spans": null, "text": null, "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "there can be trailing spaces",
        "source": "<<alfa >>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa", "spans": null, "text": null, "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "there can be leading newlines",
        "source": "<<\nalfa>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa", "spans": null, "text": null, "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "there can be trailing newlines",
        "source": "<<alfa\n>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa", "spans": null, "text": null, "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "basic content is separated by a pipe",
        "source": "<<alfa|bravo>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa", "spans": [{"text": "bravo", "type": "plaintext"}], "text": "bravo", "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "content can have any regular characters except pipes or greater thans",
        "source": "<<alfa|bravo ~!@#$%^&*(),.?:;>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa", "spans": [{"text": "bravo ~!@#$%^&*(),.?:;", "type": "plaintext"}], "text": "bravo ~!@#$%^&*(),.?:;", "type": "namedspan" }',
        "notes": ["this is not an exaustive list (i.e. not ever possible character is tested). It's meant only to be representative"],
      },
      {
        "description": "flags can come after content",
        "source": "<<alfa|bravo|charlie>>",
        "result": '{ "attrs": {}, "flags": ["charlie"], "kind": "alfa", "spans": [{"text": "bravo", "type": "plaintext"}], "text": "bravo", "type": "namedspan" }',
        "notes": ["Flages are any valid content value that doesn't have a ':' followed by a space in it (which would make it a key for a key/value pair instead)"],
      },
      {
        "description": "key value attributes can come after content",
        "source": "<<alfa|bravo|charlie: delta>>",
        "result": '{ "attrs": { "charlie": { "text": "delta", "spans": [{"text": "delta", "type": "plaintext"}]}}, "flags": [], "kind": "alfa", "spans": [{"text": "bravo", "type": "plaintext"}], "text": "bravo", "type": "namedspan" }',
        "notes": [
          "Key/value attributes are identivied by having a string that ends with a ':' followed by whitespace then a string of content",
          "The same rules that apply for the names of the spans themselves as well as the flags applie to the keys too",
          ],
      },
      {
        "description": "key value attribute values can have any content except pipes or double greater thans",
        "source": "<<alfa|bravo|charlie: ~!@#$%>>",
        "result": '{ "attrs": { "charlie": { "text": "~!@#$%", "spans": [{"text": "~!@#$%", "type": "plaintext"}]}}, "flags": [], "kind": "alfa", "spans": [{"text": "bravo", "type": "plaintext"}], "text": "bravo", "type": "namedspan" }',
        "notes": [
          "Key/value attributes are identivied by having a string that ends with a ':' followed by whitespace then a string of content",
          "The same rules that apply for the names of the spans themselves as well as the flags applie to the keys too",
          ],
      },


    ],

    "invalid": [
      {
        "description": "no spaces in name",
        "source": "<<alfa bravo>>",
        "notes": [],
      },
      {
        "description": "no trailing pipes",
        "source": "<<alfa|>>",
        "notes": [],
      },
      {
        "description": "no colons in name",
        "source": "<<alfa:bravo>>",
        "notes": [],
      },
      {
        "description": "no forward slashes in name",
        "source": "<<alfa/bravo>>",
        "notes": [],
      },
      {
        "description": "no '~' in name",
        "source": "<<alfa~bravo>>",
        "notes": [],
      },
      {
        "description": "no '!' in name",
        "source": "<<alfa!bravo>>",
        "notes": [],
      },
      {
        "description": "no '@' in name",
        "source": "<<alfa@bravo>>",
        "notes": [],
      },
      {
        "description": "no '#' in name",
        "source": "<<alfa#bravo>>",
        "notes": [],
      },
      {
        "description": "no '$' in name",
        "source": "<<alfa$bravo>>",
        "notes": [],
      },
      {
        "description": "no '%' in name",
        "source": "<<alfa%bravo>>",
        "notes": [],
      },
      {
        "description": "no '^' in name",
        "source": "<<alfa^bravo>>",
        "notes": [],
      },
      {
        "description": "no '&' in name",
        "source": "<<alfa&bravo>>",
        "notes": [],
      },
      {
        "description": "no '*' in name",
        "source": "<<alfa*bravo>>",
        "notes": [],
      },
      {
        "description": "no '(' in name",
        "source": "<<alfa(bravo>>",
        "notes": [],
      },
      {
        "description": "no ')' in name",
        "source": "<<alfa)bravo>>",
        "notes": [],
      },
      {
        "description": "no ',' in name",
        "source": "<<alfa,bravo>>",
        "notes": [],
      },
      {
        "description": "no '.' in name",
        "source": "<<alfa.bravo>>",
        "notes": [],
      },
      {
        "description": "no '?' in name",
        "source": "<<alfa?bravo>>",
        "notes": [],
      },
      {
        "description": "no ';' in name",
        "source": "<<alfa;bravo>>",
        "notes": [],
      },
    ]

  }
}

