-- title

Valid Named Spans

-- neopoligen-spec-test/

{
  "version": "0.42.0",
  "name": "Valid Named Spans",
  "notes": [
    "This is just getting started, there are more to test that I'll add in the next iteration",
    "The invalid cases aren't exhaustive (i.e. they don't test every possible character that's not allowed). They're just meant to be representative",
    "This is the first version of the parse and only deals with English. I'm working on figuring out how to do other character sets", 
  ],
  "tests": {
    "todo_valid": [
    ],
    "todo_invalid": [
    ],

    "valid": [
      {
        "description": "Basic text",
        "source": "<<alfa>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa", "spans": null, "text": null, "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "Names can have numbers",
        "source": "<<alfa1>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa1", "spans": null, "text": null, "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "Names can have hyphens",
        "source": "<<alfa-bravo>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa-bravo", "spans": null, "text": null, "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "Names can have multiple hyphens",
        "source": "<<alfa--bravo>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa--bravo", "spans": null, "text": null, "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "Names can have underscores",
        "source": "<<alfa_bravo>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa_bravo", "spans": null, "text": null, "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "Names can have multiple underscores",
        "source": "<<alfa__bravo>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa__bravo", "spans": null, "text": null, "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "There can be leading spaces",
        "source": "<< alfa>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa", "spans": null, "text": null, "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "There can be trailing spaces",
        "source": "<<alfa >>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa", "spans": null, "text": null, "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "There can be leading newlines",
        "source": "<<\nalfa>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa", "spans": null, "text": null, "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "There can be trailing newlines",
        "source": "<<alfa\n>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa", "spans": null, "text": null, "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "Basic content is separated by a pipe",
        "source": "<<alfa|bravo>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa", "spans": [{"text": "bravo", "type": "plaintext"}], "text": "bravo", "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "Content can have any regular characters except pipes or double greater thans or single backslashes",
        "source": "<<alfa|bravo <~!@#$%^&*(),.?:;>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa", "spans": [{"text": "bravo <~!@#$%^&*(),.?:;", "type": "plaintext"}], "text": "bravo <~!@#$%^&*(),.?:;", "type": "namedspan" }',
        "notes": [
          "this is not an exaustive list (i.e. not ever possible character is tested). It's meant only to be representative",
          "Doulbe '<' are allowed as long as they are the start of a new, nested named span",
        ],
      },
      {
        "description": "Content can have singel greater thans",
        "source": "<<alfa|bravo > charlie>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa", "spans": [{"text": "bravo ", "type": "plaintext"}, {"text": ">", "type": "plaintext"}, {"text": " charlie", "type": "plaintext"}], "text": "bravo > charlie", "type": "namedspan" }',
        "notes": [
          "Since both single greater than and less than characters can be used it's easy to make example of HTML <elements>", 
        ],
      },
      {
        "description": "Content can have escaped greater thans (which allows output to have double or more)",
        "source": "<<alfa|bravo \\>> charlie>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa", "spans": [{"text": "bravo ", "type": "plaintext"}, {"text": ">", "type": "escapedcharacter" }, {"text": ">", "type": "plaintext"}, {"text": " charlie", "type": "plaintext"}], "text": "bravo >> charlie", "type": "namedspan" }',
        "notes": [
          "Since both single greater than and less than characters can be used it's easy to make example of HTML <elements>", 
        ],
      },
      {
        "description": "Content can have escaped pipes",
        "source": "<<alfa|bravo \\| charlie>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa", "spans": [{"text": "bravo ", "type": "plaintext"}, {"text": "|", "type": "escapedcharacter" }, {"text": " charlie", "type": "plaintext"}], "text": "bravo | charlie", "type": "namedspan" }',
        "notes": [
        ],
      },
      {
        "description": "Content can have escaped backslahes",
        "source": "<<alfa|bravo \\\\ charlie>>",
        "result": '{ "attrs": {}, "flags": [], "kind": "alfa", "spans": [{"text": "bravo ", "type": "plaintext"}, {"text": "\\\\", "type": "escapedcharacter" }, {"text": " charlie", "type": "plaintext"}], "text": "bravo \\\\ charlie", "type": "namedspan" }',
        "notes": [
        ],
      },
      {
        "description": "Flags can come after content",
        "source": "<<alfa|bravo|charlie>>",
        "result": '{ "attrs": {}, "flags": ["charlie"], "kind": "alfa", "spans": [{"text": "bravo", "type": "plaintext"}], "text": "bravo", "type": "namedspan" }',
        "notes": ["Flages are any valid content value that doesn't have a ':' followed by a space in it (which would make it a key for a key/value pair instead)"],
      },
      {
        "description": "Flags can have numbers",
        "source": "<<alfa|bravo|charlie1>>",
        "result": '{ "attrs": {}, "flags": ["charlie1"], "kind": "alfa", "spans": [{"text": "bravo", "type": "plaintext"}], "text": "bravo", "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "Flags can have hyphens",
        "source": "<<alfa|bravo|charlie-delta>>",
        "result": '{ "attrs": {}, "flags": ["charlie-delta"], "kind": "alfa", "spans": [{"text": "bravo", "type": "plaintext"}], "text": "bravo", "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "Flags can have underscores",
        "source": "<<alfa|bravo|charlie_delta>>",
        "result": '{ "attrs": {}, "flags": ["charlie_delta"], "kind": "alfa", "spans": [{"text": "bravo", "type": "plaintext"}], "text": "bravo", "type": "namedspan" }',
        "notes": [],
      },
      {
        "description": "Key value attributes can come after content",
        "source": "<<alfa|bravo|charlie: delta>>",
        "result": '{ "attrs": { "charlie": { "text": "delta", "spans": [{"text": "delta", "type": "plaintext"}]}}, "flags": [], "kind": "alfa", "spans": [{"text": "bravo", "type": "plaintext"}], "text": "bravo", "type": "namedspan" }',
        "notes": [
          "Key/value attributes are identivied by having a string that ends with a ':' followed by whitespace then a string of content",
          "The same rules that apply for the names of the spans themselves as well as the flags applie to the keys too",
          ],
      },
      {
        "description": "Key value attribute values can have any content except pipes or double greater thans",
        "source": "<<alfa|bravo|charlie: ~!@#$%>>",
        "result": '{ "attrs": { "charlie": { "text": "~!@#$%", "spans": [{"text": "~!@#$%", "type": "plaintext"}]}}, "flags": [], "kind": "alfa", "spans": [{"text": "bravo", "type": "plaintext"}], "text": "bravo", "type": "namedspan" }',
        "notes": [
          "Key/value attributes are identivied by having a string that ends with a ':' followed by whitespace then a string of content",
          "The same rules that apply for the names of the spans themselves as well as the flags applie to the keys too",
          ],
      },

    ],

    "invalid": [
      {
        "description": "No spaces in name",
        "source": "<<alfa bravo>>",
        "notes": [],
      },
      {
        "description": "No trailing pipes",
        "source": "<<alfa|>>",
        "notes": [],
      },
      {
        "description": "No colons in name",
        "source": "<<alfa:bravo>>",
        "notes": [],
      },
      {
        "description": "No forward slashes in name",
        "source": "<<alfa/bravo>>",
        "notes": [],
      },
      {
        "description": "No '~' in name",
        "source": "<<alfa~bravo>>",
        "notes": [],
      },
      {
        "description": "No '!' in name",
        "source": "<<alfa!bravo>>",
        "notes": [],
      },
      {
        "description": "No '@' in name",
        "source": "<<alfa@bravo>>",
        "notes": [],
      },
      {
        "description": "No '#' in name",
        "source": "<<alfa#bravo>>",
        "notes": [],
      },
      {
        "description": "No '$' in name",
        "source": "<<alfa$bravo>>",
        "notes": [],
      },
      {
        "description": "No '%' in name",
        "source": "<<alfa%bravo>>",
        "notes": [],
      },
      {
        "description": "No '^' in name",
        "source": "<<alfa^bravo>>",
        "notes": [],
      },
      {
        "description": "No '&' in name",
        "source": "<<alfa&bravo>>",
        "notes": [],
      },
      {
        "description": "No '*' in name",
        "source": "<<alfa*bravo>>",
        "notes": [],
      },
      {
        "description": "No '(' in name",
        "source": "<<alfa(bravo>>",
        "notes": [],
      },
      {
        "description": "No ')' in name",
        "source": "<<alfa)bravo>>",
        "notes": [],
      },
      {
        "description": "No ',' in name",
        "source": "<<alfa,bravo>>",
        "notes": [],
      },
      {
        "description": "No '.' in name",
        "source": "<<alfa.bravo>>",
        "notes": [],
      },
      {
        "description": "No '?' in name",
        "source": "<<alfa?bravo>>",
        "notes": [],
      },
      {
        "description": "No ';' in name",
        "source": "<<alfa;bravo>>",
        "notes": [],
      },
      {
        "description": "Flags can't have spaces",
        "source": "<<alfa|bravo|charlie delta>>",
        "notes": [],
      },
      {
        "description": "Flags can't have non-alphanumeric characters other than underscore and hyphen",
        "source": "<<alfa|bravo|charlie:delta>>",
        "notes": [],
      },
    ]

  }
}

-- /neopoligen-spec-test


