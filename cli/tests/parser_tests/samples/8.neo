-- title

Make A Button To Copy Text Onto The Clipboard

-- tldr/

-- html/
-- show

<p id="content">
  lima <em>delta</em> november
</p>

<button id="copyButton">
  Copy Content
</button>

-- /html

-- javascript/
-- show

const copyContent = async () => {
  try {
    await navigator.clipboard.writeText(
      content.innerText
    )
    copyButton.innerHTML = "Copied!"
  } catch (err) {
    console.error("Could not copy to clipboard")
  }
}

document.addEventListener("DOMContentLoaded", () => {
  copyButton.addEventListener("click", copyContent)
})

-- /javascript


-- /tldr

-- notes

- I'm using __innerText__ instead of __innerHTML__
in the copy. Using __innerHTML__ put the tags 
themselves in the output when I posted into
a plain-text editor


