[!- import "built-in/helpers.neoj" as neo -!]

<section
  [@- site.get_section_attrs(site, page, section, "json5-simple-table-section built-in flow") -@]>

[!- if section.error -!]
<pre>Problem in json5-advanced-table

[@ section.error @]</pre>
[!- else -!]
<table>
  [!- if section.data.header_rows -!]
    <thead>
      [!- for row in section.data.header_rows -!]
        <tr>
          [!- for cell in row -!]
            <th>[@- cell -@]</th>
          [!- endfor -!]
        </tr>
      [!- endfor -!]
    </thead>
  [!- endif -!]
  [!- if section.data.body_rows -!]
    <tbody>
      [!- for row in section.data.body_rows -!]
        <tr>
          [!- for td in row -!]
            <td>[@- td -@]</td>
          [!- endfor -!]
        </tr>
      [!- endfor -!]
    </tbody>
  [!- endif -!]
  [!- if section.data.footer_rows -!]
    <tfoot>
      [!- for row in section.data.footer_rows -!]
        <tr>
          [!- for cell in row -!]
            <th>[@- cell -@]</th>
          [!- endfor -!]
        </tr>
      [!- endfor -!]
    </tfoot>
  [!- endif -!]
</table>
[!- endif -!]
</section>

[@- neo.output_end_section(site, page, section) -@]
