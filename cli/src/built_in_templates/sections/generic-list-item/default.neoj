[!- import "built-in/helpers.neoj" as neo -!]

<li 
  [@- site.get_section_attrs(site, page, section, "generic-list-item-section built-in flow") -@]>
[!- for child in section.children -!] 
[!- if loop.length == 1 -!]
[@- neo.output_section_with_template(site, page, child, "built-in/sections/generic-list-item-single/default.neoj") -@]
[!- else -!]
[@- neo.output_section(site, page, child) -@]
[!- endif -!]
[!- endfor -!]
</li>
