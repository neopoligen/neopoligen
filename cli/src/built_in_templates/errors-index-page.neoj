<!DOCTYPE html>
<html>
<head>
<style>
body {
    background-color: #200;
    color: #dfd;
    line-height: 1.3;
}
header, main, footer {
    max-width: 62ch;
    margin: auto;
}
.bordered {
    padding: 1rem;
    border: 1px solid #dfd;
}
.flow > :where(:not(:first-child)) {
  margin-top: var(--flow-space, 1em);
}
</style>
</head>
<body>
<header><a href="/">Home</a></header>
<main class="flow">
<h3>Error---</h3>
<div class="bordered"><pre>[! autoescape true !][@ error @][! endautoescape !]</pre></div>
<h3>Template Load Errors</h3>
<div class="bordered"><ul>
<pre>[! autoescape true !][@ error @][! endautoescape !]</pre>
</ul>
</div>
<h3>Source</h3>
<div class="bordered"><pre>[! autoescape true !][@ page.source @][! endautoescape !]</pre></div>
<h3>Raw Data</h3>
<div class="bordered"><pre>[! autoescape true !][@ page.sections|tojson(true) @][! endautoescape !]</pre></div>
<h3>Tree</h3>
<div class="bordered"><pre>[! autoescape true !][@ ast|tojson(true) @][! endautoescape !]</pre></div>
</main>
</body>
</html>
