[!- macro debug_section_tree(site, page, sections) -!]
<ul>
[!- for section in sections -!]
<li>
[@ section.kind @]
[@ debug_section_tree(site, page, section.children) @]
[! if section.end_section !] 
[@ section.end_section.kind @]
[@ debug_section_tree(site, page, section.end_section.children) @]
[! endif !]
</li>
[!- endfor -!]
</ul>
[!- endmacro -!]

[!- macro output_css(site, page) -!]
[!- for section in page.sections -!]
[!- if section.kind == "css" -!]
[!- include "built-in/css-output.neoj" -!]
[!- endif -!]
[!- endfor -!]
[!- endmacro -!]

[!- macro output_end_section(site, page, section) -!]
[!- if section.end_section -!]
[@- output_section(site, page, section.end_section) -@]
[!- endif -!]
[!- endmacro -!]

[!- macro output_just_first_block(site, page, section) -!]
[!- for section in section.children -!]
[!- if loop.first -!]
[@- output_section(site, page, section) -@]
[!- endif -!]
[!- endfor -!]
[!- endmacro -!]

[!- macro output_just_first_block_spans(site, page, section) -!]
[!- for child in section.children -!]
[!- if loop.first -!]
[@- output_spans(site, page, child.spans) -@]
[!- endif -!]
[!- endfor -!]
[!- endmacro -!]

[!- macro output_only_sections(site, page, list_as_string) -!]
[! set list = list_as_string|split|list !]
[!- for section in page.sections -!]
[!- if section.kind in list -!]
[@- output_section(site, page, section) -@]
[!- endif -!]
[!- endfor -!]
[!- endmacro -!]

[!- macro output_scripts(site, page) -!]
[!- for section in page.sections -!]
[!- if section.kind == "script" -!]
[!- include "built-in/script-output.neoj" -!]
[!- endif -!]
[!- endfor -!]
[!- endmacro -!]

[!- macro output_section(site, page, section) -!]
[!- include section.template_list -!]
[!- endmacro -!]

[!- macro output_section_with_template(site, page, section, template) -!]
[!- include template -!]
[!- endmacro -!]

[!- macro output_sections(site, page, sections) -!]
[!- for section in sections -!]
[@- output_section(site, page, section) -@]
[!- endfor -!]
[!- endmacro -!]

[!- macro output_skip_first_block(site, page, section) -!]
[!- for child in section.children -!]
[!- if not loop.first -!]
[@- output_section(site, page, child) -@]
[!- endif -!]
[!- endfor -!]
[!- endmacro -!]

[!- macro output_span(site, page, span) -!]
[!- if span.kind -!]
[!- include ["spans/" + span.kind + ".neoj", "spans/" + span.type + ".neoj", "built-in/span-text.neoj"] -!]
[!- else -!]
[!- include ["spans/" + span.type + ".neoj", "built-in/span-text.neoj"] -!]
[!- endif -!]
[!- endmacro -!]

[!- macro output_spans(site, page, spans) -!]
[!- for span in spans -!]
[@- output_span(site, page, span) -@]
[!- endfor -!]
[!- endmacro -!]

