[!- import "built-in/helpers.neoj" as neo -!]

<!DOCTYPE html>
<html>
<head>
<style>
body {
  background-color: #0d1229;
  color: #f0e5d8;
}

.built-in-flow > :where(:not(:first-child)) {
  margin-top: var(--flow-space, 1em);
}


</style>
[@ neo.output_css(site, page) @]
</head>
<body class="built-in-flow">
<header>
<div>Head's up: This is the built-in fallback template for posts. 
If you're seeing it, it means something happened to the main
template which should be at &quot;pages/post/default.neoj&quot;
in your themes folder. Things on this page probably won't
look quite right until that template is back in place.</div>
</header>

<main class="flow">
[@ neo.output_sections(site, page, page.sections) @]
</main>

<footer>
<div>
  [! if page.issues !]
    <h3>Issues</h3>
    <ul class="built-in-flow flow>
      [@- neo.debug_page_issues(site, page) -@]
    </ul>
  [! endif !]

  <details>
    <summary>Source</summary>
    <div><pre>[@ page.source @]</pre></div>
  </details>
  <details>
    <summary>Section Tree</summary>
    <div>[@ neo.debug_section_tree(site, page, page.sections) @]</div>
  </details>
  <details>
    <summary>Sections</summary>
    <div><pre>[@ page.sections|tojson(true) @]</pre></div>
  </details>
</div>
<div>[@ site.generated_at("Generated on %a. %B %-d at %-I:%M:%S%p") @]</div>
</footer>
[@- neo.output_scripts(site, page) -@]
</body>
</html>




