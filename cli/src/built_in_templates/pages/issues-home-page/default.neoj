[!- import "built-in/helpers.neoj" as neo -!]
<!DOCTYPE html>
<html>
<head>
<style>
body {
    background-color: #200;
    color: #dfd;
    line-height: 1.3;
}
header, main, footer {
    max-width: 62ch;
    margin: auto;
}
.bordered {
    border-bottom: 1px solid #dfd;
    border-top: 1px solid #dfd;
    padding: 1rem;
}
.built-in-flow > :where(:not(:first-child)) {
  margin-top: var(--flow-space, 1em);
}
.flow > :where(:not(:first-child)) {
  margin-top: var(--flow-space, 1em);
}
pre {
    font-size: 0.72rem;
}
</style>
</head>
<body>
        <header>
            <a href="/">Home</a></header>
        <main>
            <h1>Something unexpected happened</h1>
            <p>There were some problems making the site. Not a big deal. 
                That happens sometimes and we can fix it. Here's
            what we know to get started:</p>

            <h2>TODO</h2>
            <ul>
                <li>Output errors from pages with IDs</li>
                <li>Out paths for files that don't have IDs</li>
            </ul>

        <h2>Issues On Pages With Ids</h2>
            <ul>
        [! for id in site.get_page_ids(site, page) !]
            [! set check_page = site.get_page_with_id(site, page, id) !]
            [! if check_page.issues !]
                <li class="built-in built-in-flow">
                    <details><summary>[@ check_page.source_display_path -@]</summary>
                    <ul>
                    [@- neo.debug_page_issues(site, check_page) -@]
                    </ul>
                    </details>
                </li>
            [! endif !]
        [! endfor !]
            </ul>


        <h2>Issues On Pages Without Ids</h2>
            <ul>
        [! for display_path in site.get_keys_for_pages_without_ids(site, page) !]
                [@ display_path @]
            [! set check_page = site.get_page_with_display_path(site, page, display_path) !]
                [@ check_page @]
            [! if check_page.issues !]
                <li class="built-in built-in-flow">
                    <details><summary>[@ check_page.source_display_path -@]</summary>
                    <ul>
                    [@- neo.debug_page_issues(site, check_page) -@]
                    </ul>
                    </details>
                </li>
            [! endif !]
        [! endfor !]
            </ul>

<h2>Pages</h2>
            <ul>
            [! for page_error in page_errors !]
                <li>[! include "built-in/errors-page-error.neoj" !]</li>
            [! endfor !]
            </ul>
[! for template_load_error in template_load_errors !]
[! if loop.first !]
<h3>Problems Loading Templates</h3>
<div class="bordered">
[! endif !]
<div>[@ template_load_error.message @]</div>
                <div><pre>[@ template_load_error.details@]</pre></div>
[! if loop.last!]
</div>
[! endif !]
[! endfor !]



            [#
<h3>Error</h3>
<div class="bordered"><pre>[! autoescape true !][@ '' @][! endautoescape !]</pre></div>
<h3>Source</h3>
<div class="bordered"><pre>[! autoescape true !][@ page.source @][! endautoescape !]</pre></div>
<h3>Raw Data</h3>
<div class="bordered"><pre>[! autoescape true !][@ page.sections|tojson(true) @][! endautoescape !]</pre></div>
<h3>Tree</h3>
<div class="bordered"><pre>[! autoescape true !][@ ast|tojson(true) @][! endautoescape !]</pre></div>
            #]

</main>
        <footer>
        <div>[@ site.generated_at("Generated on %a. %B %-d at %-I:%M:%S%p") @]</div>
        </footer>

</body>
</html>
