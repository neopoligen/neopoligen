[!- import "built-in/helpers.neoj" as neo -!]

<!DOCTYPE html>
<html>
    <head>
    <style>
body {
    background-color: #200;
    color: #dfd;
    line-height: 1.3;
}
header, main, footer {
    max-width: 62ch;
    margin: auto;
}
.bordered {
    border-bottom: 1px solid #dfd;
    border-top: 1px solid #dfd;
    padding: 1rem;
}
.flow > :where(:not(:first-child)) {
  margin-top: var(--flow-space, 1em);
}
pre {
    font-size: 0.72rem;
}
</style>
</head>
<body>
    <header>
            <a href="/">Home</a></header>
<main class="flow">
        <h1>Something unexpected happened</h1>
        <p>There were some problems making this page. Not a big deal. 
            That happens sometimes and we can fix it. Here's
        what we know to get started:</p>
            <aside>SIDENOTE: These issues can be very cryptic to read. 
                I'm working on making that better. I'm also working
                on a video with some help digging into them</aside>
        <ul class="flow">
            [@- neo.debug_page_issues(site, page) -@]
                [#
        [! for issue in page.issues !]
            <li class="flow">
                    [! include [
                        "issues/page-issue/default.neoj", 
                        "built-in/issues/page-issue/default.neoj" 
                    ]!]
            </li>
        [! endfor !]
                #]
        </ul>
</body>
</html>


