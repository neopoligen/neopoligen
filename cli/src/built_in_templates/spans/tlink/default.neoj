[!- import "built-in/helpers.neoj" as neo -!]
[!- set href = site.get_page_href_from_span(span) -!]
[!- set title = site.get_page_title_from_span(span) -!]
[!- if href and title -!]
<a href="[@ site.get_page_href_from_span(span) @]">
[@- neo.output_spans(site, page, site.get_page_title_from_span(span)) -@]
</a>
[!- endif -!]
[@- '' -@]

