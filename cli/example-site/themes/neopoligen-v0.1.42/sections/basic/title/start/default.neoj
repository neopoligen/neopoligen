[!- import "helpers/theme.neoj" as theme -!]
<section [@ section.attr_flag_list("title-section flow") @]>
  <h1>
  [! for child in section.children() !]
    [! if loop.first !]
      [@ theme.output_spans(site, page, child.spans()) @]
    [! endif !]
  [! endfor !]

  </h1>
  [!- include "subsections/skip-one-block.neoj" -!]

