[! import "includes/theme.neoj" as theme !]

<section 
    [! if "no-flow" in section.flags !]
      [@- theme.section_classes(section, "div-section") -@] 
    [! else !]
      [@- theme.section_classes(section, "div-section flow") -@] 
    [! endif !]
    [@- section.attr_string -@]>
[! include "subsections/content-all-blocks.neoj" !]
[! include "subsections/end-section.neoj" !]

