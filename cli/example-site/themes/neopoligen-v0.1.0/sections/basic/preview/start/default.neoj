[! import "includes/theme.neoj" as theme !]

<section 
    [@- theme.section_classes(section, "preview-section") -@] 
    [@- section.attr_string -@]>

[! if 'id' in section.attrs !]
<a href="[@ site.pages[section.attrs.id].absolute_url @]">[@ site.pages[section.attrs.id].title @]</a>
<div class="preview-blurb">
[! for sub_section in site.pages[section.attrs.id].sections !]
[! if sub_section.type == "blurb" !]
[@- theme.output_section(site, site.pages[section.attrs.id], sub_section) -@]
[! endif !]
[! endfor !]
</div>
[! endif !]


[! include "subsections/content-all-blocks.neoj" !]
[! include "subsections/end-section.neoj" !]

