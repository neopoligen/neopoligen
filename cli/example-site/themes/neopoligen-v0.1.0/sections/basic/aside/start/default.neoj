[! import "includes/theme.neoj" as theme !]

<section 
    [@- theme.section_classes(section, "aside-section") -@] 
    [@- section.attr_string -@]>
    <div class="aside-title">Aside</div>
<aside class="flow">
[! include "subsections/content-all-blocks.neoj" !]
</aside>

[! for child in section.children !]
    [@ theme.output_section(site, page_id, child) @] 
[! endfor !]
