[!- import "built-in/macros.neoj" as neo -!]

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />


[! if "no-css" not in page.flags() !]
[# 
  NOTE: taking this out until a full 
  solution for dark/light mode is built
<style>

  :root {
    --color-background: #0d1229;
  }
  html {
    visibility: hidden;
  }
  body {
    background-color: var(--color-background);
    font-display: block;
  }
</style>
#]
<link rel="stylesheet" href="[@ neo.theme_folder() @]/styles/theme.css" />
<link rel="stylesheet" href="[@ neo.theme_folder() @]/styles/syntax-highlighting/code-solarized-dark.css" />
[! endif !]

<!-- TODO: move `page.` and `site.` to `neo.` -->
<title>[@ page.title() @]</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta property="og:title" content="[@ page.title() @]" />
<meta property="og:description" content="a post from alan w. smith" />
<meta property="og:type" content="article" />
<meta property="og:url" content="[@ site.site_root() @][@ page.href() @]" />
<meta property="og:image" content="https://res.cloudinary.com/awsimages/image/upload/og-image-no-title-white-on-black.jpg" />
<meta name="twitter:card" content="summary_large_image" />
<link rel="apple-touch-icon" sizes="180x180" href="[@ neo.theme_folder() @]/favicons/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="[@ neo.theme_folder() @]/favicons/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="[@ neo.theme_folder() @]/favicons/favicon-16x16.png" />
<link rel="manifest" href="[@ neo.theme_folder() @]/favicons/site.webmanifest" />
<link rel="mask-icon" href="[@ neo.theme_folder() @]/favicons/safari-pinned-tab.svg" color="#5bbad5" />
<link rel="shortcut icon" href="[@ neo.theme_folder() @]/favicons/favicon.ico" />
<meta name="msapplication-TileColor" content="#da532c" />
<meta name="msapplication-config" content="[@ neo.theme_folder() @]/favicons/browserconfig.xml" />
<meta name="theme-color" content="#000000" />
<meta name="description" content="A post from alan w. smith" />
[@ neo.output_css(sections) @]

</head>
<body>

<header class="wrapper-medium">
  <a href="/">home</a> ~
  <a href="https://links.alanwsmith.com/">projects</a> ~
  <a href="https://socials.alanwsmith.com/">socials</a>
</header>

[! if "no-wrapper" not in page.flags() !]
  <main class="wrapper-medium flow">
[! else !]
  <main class="flow">
[! endif !]
    [!- block body_main -!][!- endblock -!]
  </main>

<footer class="border-top-alt-3-60">
  <div>
    made by alan w smith<br />
    who has  <a href="https://links.alanwsmith.com/">made some other things</a><br />
    and is on <a href="https://socials.alanwsmith.com/">some social networks</a>
  </div>
  <div>
    this site has <a href="/feeds/posts.xml">an rss feed</a><br />
    and <a href="/neo-files/report.html">a giant list of files</a><br />
    &copy; 1998-2025
  </div>
</footer>

[#
<div class="wrapper-large">
  [!- include "includes/debugging.neoj" -!]
</div>
#]


[@ neo.output_scripts(sections) @]

<script type="module">
const url = new URL(window.location.href)
if (url.hostname === "localhost") {
  const el = document.createElement('div');
  el.classList.add('wrapper-medium');
  el.classList.add('text-align-center');
  el.classList.add('font-size-small');
  el.classList.add('color-primary-30');
  el.innerHTML = `[@ page.id() @]<br /><a href="https://www.alanwsmith.com${url.pathname}" target="_blank">prod</a>`
  el.classList.add("center")
  document.body.appendChild(el)
}
</script>


[#
<pre>
[@ page.ast|tojson(true) @]
</pre>
#]
</body>
</html>
