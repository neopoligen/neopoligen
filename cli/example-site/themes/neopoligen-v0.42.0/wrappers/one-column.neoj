[!- import "built-in/macros.neoj" as neo -!]

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<style>
  :root {
    --color-background: #0d1229;
  }
  html {
    visibility: hidden;
  }
  body {
    background-color: var(--color-background);
    font-display: block;
  }
</style>
<link rel="stylesheet" href="[@ neo.theme_folder() @]/styles/theme.css" />
<link rel="stylesheet" href="[@ neo.theme_folder() @]/styles/syntax-highlighting/code-solarized-dark.css" />

<!-- TODO: move page.... and site.... to neo.... -->
<title>[@ page.title() @]</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta property="og:title" content="[@ page.title() @]" />
<meta property="og:description" content="a post from alan w. smith" />
<meta property="og:type" content="article" />
<meta property="og:url" content="[@ site.site_root() @][@ page.href() @]" />
<meta property="og:image" content="https://res.cloudinary.com/awsimages/image/upload/og-image-no-title-white-on-black.jpg" />
<link rel="apple-touch-icon" sizes="180x180" href="[@ neo.theme_folder() @]/favicons/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="[@ neo.theme_folder() @]/favicons/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="[@ neo.theme_folder() @]/favicons/favicon-16x16.png" />
<link rel="manifest" href="[@ neo.theme_folder() @]/favicons/site.webmanifest" />
<link rel="mask-icon" href="[@ neo.theme_folder() @]/favicons/safari-pinned-tab.svg" color="#5bbad5" />
<link rel="shortcut icon" href="[@ neo.theme_folder() @]/favicons/favicon.ico" />
<meta name="msapplication-TileColor" content="#da532c" />
<meta name="msapplication-config" content="[@ neo.theme_folder() @]/favicons/browserconfig.xml" />
<meta name="theme-color" content="#000000" />
<meta name="description" content="A post from alan w. smith" />
[@ neo.output_css() @]
</head>
<body class="flow">

<header class="wrapper-medium">
  <a href="/">home</a> ~
  <a href="https://links.alanwsmith.com/">projects</a> ~
  <a href="https://socials.alanwsmith.com/">socials</a>
</header>

<main class="wrapper-medium flow">
    [!- block body_main -!][!- endblock -!]
</main>

<footer class="wrapper-medium">
  [#
  <div class="generated-timestamp">[@ neo.generated_at("Generated on %a. %B %-d, %Y at %-I:%M%p " + neo.time_zone()) @]</div>
  #]

  <div class="center">
    made by alan w smith
  </div>
  <div class="center">
    <a href="https://links.alanwsmith.com/">other projects</a> ~
    <a href="https://socials.alanwsmith.com/">socials</a>
  </div>

[#
  [!- include "includes/debugging.neoj" -!]
  #]

</footer>

[@ neo.output_scripts() @]
</body>
</html>
