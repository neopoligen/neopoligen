[!- import "built-in/macro-loader.neoj" as neo -!]

[# TYPE: basic #]
[# HOIST: [class, id] #]

<section [@- neo.section_attrs("flow") -@]>
  [# No output by default for comments, but remember
  that the text can still go out if the source
  is published or a typo happens #]
</section>

[@- neo.output_end_section(section) -@]


