[!- import "built-in/macros.neoj" as neo -!]

[# TYPE: csv #]
[# HOIST: [] #]

<section [@- neo.section_attrs() -@]>
  [!- if section.error -!]

    <pre>Problem in csv-table[@- "\n\n" -@]
    [@ section.error @]</pre>

  [!- else -!]

    <table>
      [! if "header" in section.attrs !]
        <thead>
          [!- for row in section.data -!]
            <tr>
              [!- for th in row -!]
                <th>[@- th -@]</th>
              [!- endfor -!]
            </tr>
          [!- endfor -!]
        </thead>
      [! else !]
        <tbody>
          [!- for row in section.data -!]
            <tr>
              [!- for td in row -!]
                <td>[@- td -@]</td>
              [!- endfor -!]
            </tr>
          [!- endfor -!]
        </tbody>
      [! endif !]
    </table>

  [!- endif -!]

</section>

[@- neo.output_end_section(section) -@]
