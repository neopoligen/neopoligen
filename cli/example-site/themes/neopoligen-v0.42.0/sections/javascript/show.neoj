[!- import "built-in/macros.neoj" as neo -!]

[# TYPE: javascript #]
[# HOIST: [] #]

<section [@- neo.section_attrs("flow show-javascript") -@]>
  <h4 class="show-javascript-heading">JavaScript</h4>
  <div class="javascript-body">
  <pre class="font-size-xsmall"><code>
  [@- site.highlight_code(section.body, "js") -@]
  </code></pre>
  </div>
</section>

[@- neo.output_end_section(section) -@]

