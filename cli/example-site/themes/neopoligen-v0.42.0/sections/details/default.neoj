[!- import "built-in/macros.neoj" as neo -!]

[# TYPE: none #]
[# HOIST: [class, id] #]

<section [@- neo.section_attrs("flow") -@]>
  <details>
  [!- if "summary" in section.attrs -!]
    <summary>[@ neo.output_attr('summary') @]</summary>
  [!- endif -!]
  [@- neo.output_all_child_sections(section) -@]
  </details>
</section>

[@- neo.output_end_section(section) -@]

