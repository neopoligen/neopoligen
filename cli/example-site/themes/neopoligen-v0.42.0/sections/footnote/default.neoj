[!- import "built-in/macros.neoj" as neo -!]

[# TYPE: basic #]
[# HOIST: [] #]

<section [@- neo.section_attrs("flow") -@]>

  <div>
    [!- if "id" in section.attrs -!]
      <a 
        href="#footnote-[@ neo.output_spans(section.attrs.id[0].spans) @]-link"
        ><small id="footnote-[@ neo.output_spans(section.attrs.id[0].spans) @]-text">
          [@- neo.output_spans(section.attrs.id[0].spans) -@]
          [@- ' ' -@]
          &#x2934;</a></small>
    [!- endif -!]
  </div>

  <div>
    <div>
      [!- if "url" in section.attrs -!]
        <a href="[@- neo.output_spans(section.attrs.url[0].spans) -@]">
      [!- endif -!]
      [!- if "title" in section.attrs -!]
        [@- neo.output_spans(section.attrs.title[0].spans) -@]
      [!- endif -!]
      [!- if "url" in section.attrs -!]
        </a>
      [!- endif -!]
    </div>
    <div>
      [@- neo.output_all_child_sections(section) -@]
    </div>
  </div>

</section>

[@- neo.output_end_section(section) -@]
