[!- import "built-in/macros.neoj" as neo -!]

[# TYPE: raw #]
[# HOIST: [] #]

<section [@- neo.section_attrs("flow") -@]>

  [!- if "title" in section.attrs -!]
    <div class="code-section-title">[@ neo.output_attr('title') @]</div>
  [!- endif -!]

  [!- if "subtitle" in section.attrs -!]
    <div class="code-section-subtitle">[@ neo.output_attr('subtitle') @]</div>
  [!- endif -!]

  [!- if "file" in section.attrs -!]
    <div class="code-section-file">file: [@ neo.output_attr('file') @]</div>
  [!- endif -!]


<pre><code>
[!- autoescape false -!]
[!- if section.flags|length > 0 -!]
[@- highlight_code_section(section.body, section.flags[0]) -@]
[!- else -!]
[@- highlight_code_section(section.body, "txt") -@]
[!- endif -!]
[!- endautoescape -!]
</code></pre>

  [!- if "figure" in section.attrs -!]
    <div class="border-top-color-alt-1-40 
    text-align-right  font-size-xsmall
    color-primary-40 margin-top-medium
">figure [@ neo.output_attr('figure') @]</div>
  [!- endif -!]


</section>

[@- neo.output_end_section(section) -@]

