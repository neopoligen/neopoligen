<div>Error: [@ section.message @]</div>
<div>Occurred at line: [@ section.line @] column: [@ section.column @]</div>

<h3>Details</h3>

<div class="paring-error-report">
<pre>
[!- autoescape true -!]
[@- section.output_source -@]
[!- endautoescape -!]
[!- autoescape true -!]
<mark class="parser-error">[@- section.output_remainder -@]</mark>
[!- endautoescape -!]
</pre>
</div>

