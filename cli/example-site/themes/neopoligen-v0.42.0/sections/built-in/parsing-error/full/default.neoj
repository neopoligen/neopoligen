<div>Error: [@ section.message @]</div>
<div>Occurred at line: [@ section.line @] column: [@ section.column @]</div>

<h3>Details</h3>

<div class="paring-error-report">
<pre class="parsing-success">
[!- autoescape true -!]
[@- section.output_source -@]
[!- endautoescape -!]
</pre>
<pre class="parsing-error">
[!- autoescape true -!]
[@- section.output_remainder -@]
[!- endautoescape -!]
</pre>
</div>

