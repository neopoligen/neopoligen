[! import "built-in-helpers" as neo -!]

<section class="flow">

[@- neo.output_all_sections(site, page, section.children) -@]

[#
[! for child in section.children !]
[@ neo.output_section(site, child) @]
[! endfor !]
#]

[#
[! for end_section in section.end_sections!]
[@ neo.output_section(site, end_section) @]
[! endfor !]
#]
