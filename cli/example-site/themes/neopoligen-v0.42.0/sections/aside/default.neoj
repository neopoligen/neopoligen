[!- import "built-in/macros.neoj" as neo -!]

[# TYPE: basic #]
[# HOIST: [class, id] #]


<section [@- neo.section_attrs("flow") -@]>
  <aside>
  [!- if "title" in section.attrs -!]
    <div class="aside-title">[@ neo.output_attr('title') @]</div>
  [! else !]
    <div class="aside-title">Aside</div>
  [!- endif -!]
    <div class="aside-body">
    [@- neo.output_all_child_sections(section) -@]
    </div>
  </aside>
</section>

[@- neo.output_end_section(section) -@]

