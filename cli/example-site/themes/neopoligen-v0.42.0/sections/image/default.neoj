[!- import "built-in/macros.neoj" as neo -!]

[# TYPE: basic #]
[# HOIST: [class] #]

[! set image_path = "/neo-files/images/" + section.flags[0] + "/" + section.flags[0] + ".avif" !]

<section [@- neo.section_attrs() -@]>
  <div>
    <img 
      src="[@ image_path @]" 
      alt="[@ neo.output_alt_text() @]" 
      /></div>
</section>

[@- neo.output_end_section(section) -@]


