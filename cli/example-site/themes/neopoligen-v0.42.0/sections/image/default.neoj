[!- import "built-in/macros.neoj" as neo -!]

[# TYPE: basic #]
[# HOIST: [alt, class, id] #]

<section [@- neo.section_attrs() -@]>
  <div><img 
    [@ site.image_from_section(section, [100, 400, 800, 1200, 1600, 3000]) @] 
    sizes="(max-width: 500px) 400px,
         (max-width: 700px) 600px, 
         800px"
  /></div>
</section>

[@- neo.output_end_section(section) -@]
