[!- import "built-in/macros.neoj" as neo -!]

[# TYPE: basic #]
[# HOIST: [] #]


<section 
  [! if "no-flow" in section.flags !] 
    [@- neo.section_attrs()  -@]
  [! else !]
    [@- neo.section_attrs("flow") -@]
  [! endif !]
>


  <h2>[@- neo.spans_from_first_block(section) -@]</h2>
  
  [@- neo.output_child_sections_skipping_first(section) -@]
  
</section>

[@- neo.output_end_section(section) -@]

