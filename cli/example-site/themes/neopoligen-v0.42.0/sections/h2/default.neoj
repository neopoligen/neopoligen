[!- import "theme/helpers.neoj" as neo -!]

<section 
  [@- site.get_section_attrs(site, page, section, "h2-section flow") -@]>

<h2>[@- neo.output_just_first_block_spans(site, page, section) -@]</h2>

[@- neo.output_skip_first_block(site, page, section) -@]

</section>

[@- neo.output_end_section(site, page, section) -@]


