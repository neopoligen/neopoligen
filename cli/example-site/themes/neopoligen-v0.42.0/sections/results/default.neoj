[!- import "built-in/macros.neoj" as neo -!]

[# TYPE: raw #]
[# HOIST: [] #]

<section [@- neo.section_attrs() -@]>
<div class="results-header">Output:</div>
<div class="results-body">
<pre><code>
[!- autoescape true -!]
[@- section.body -@]
[!- endautoescape -!]
</code></pre>
</div>

  [!- if "figure" in section.attrs -!]
    <div class="border-top-alt-1-60 
    text-align-right 
font-size-xsmall
        color-primary-40
margin-top-medium
">figure [@ neo.output_attr('figure') @]</div>
  [!- endif -!]

</section>

[@- neo.output_end_section(section) -@]

