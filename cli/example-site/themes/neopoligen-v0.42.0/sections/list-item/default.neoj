[!- import "built-in/macro-loader.neoj" as neo -!]

[# TYPE: none #]
[# HOIST: [] #]

<li class="flow">
  [!- for child in section.children -!] 
    [!- if loop.length == 1 -!]
      [@- neo.output_section_with_template(child, "sections/generic-list-item-single/default.neoj") -@]
    [!- else -!]
      [@- neo.output_section(child) -@]
    [!- endif -!]
  [!- endfor -!]
</li>
