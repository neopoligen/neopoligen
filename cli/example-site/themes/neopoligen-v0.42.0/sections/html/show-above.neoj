[!- import "built-in/macros.neoj" as neo -!]

[# TYPE: html #]
[# HOIST: [] #]

<section [@- neo.section_attrs("flow show-html") -@]>
  [!- if "h2" in section.attrs -!]
    <h2>[@ neo.output_attr('h2') @]</h2>
  [!- endif -!]
  [!- if "h3" in section.attrs -!]
    <h3>[@ neo.output_attr('h3') @]</h3>
  [!- endif -!]

  <h4 class="show-html-heading">Output</h4>
  [@ section.body @]

  <h4 class="show-html-heading">HTML</h4>
  [!- if "title" in section.attrs -!]
    <div class="code-block-title">[@ neo.output_attr('title') @]</div>
  [!- endif -!]
  [!- if "subtitle" in section.attrs -!]
    <div class="code-block-subtitle">[@ neo.output_attr('subtitle') @]</div>
  [!- endif -!]
  <pre><code>
    [@- site.highlight_code(section.body, "html") -@]
  </code></pre>

</section>

[@- neo.output_end_section(section) -@]


