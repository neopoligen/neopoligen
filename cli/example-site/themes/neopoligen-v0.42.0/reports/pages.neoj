[!- import "built-in/macros.neoj" as neo -!]
<!DOCTYPE html>
<html lang="en">
<head>
  <title>Site Report</title>
<meta charset="UTF-8" />
<style>
  :root {
    --color-background: #0d1229;
  }
/*
  html {
    visibility: hidden;
  }
  */
  body {
    background-color: var(--color-background);
    font-display: block;
  }
  .report_grid {
    display: grid;
    grid-template-columns: 1fr 4fr;
  }
</style>
<link rel="stylesheet" href="[@ neo.theme_folder() @]/styles/theme.css" />
<link rel="stylesheet" href="[@ neo.theme_folder() @]/styles/syntax-highlighting/code-solarized-dark.css" />
</head>
<body>

<div class="report_grid flow">
[!- for page in pages_with_dates -!]
[! if page.status == "done" !]
<div class="green">
[@ page.status @]
</div>
[! else !]
<div class="red">
[@ page.status @]
</div>
[! endif !]

<div>
<a href="[@- page.href -@]">[@- page.title -@]<br />[@- page.id -@]</a>
</div>
[!- endfor -!]
</div>
</body>
</html>



