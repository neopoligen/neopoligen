[!- macro output_spans(payload) -!]
[!- for span in payload -!]
[# TODO: Collapse plaintext so it always has kind and you can just use that #]
[!- if "kind" in span -!]
[!- include ["spans/" + span.kind + "/default.neoj", "spans/" + span.type + "/default.neoj"] -!]
[!- else -!]
[!- include "spans/" + span.type + "/default.neoj" -!]
[!- endif -!]
[!- endfor -!]
[!- endmacro -!]