[#- 

  Usage: 
  
    neo.output_attr('title')

  Automatically looks for the current `section`

-#]

[!- from "macros/output_spans.neoj" import output_spans -!]
[!- macro output_attr(attr) -!]
  [!- if attr in section.attrs -!]
    [!- for slice in section.attrs[attr] -!]
      [@- output_spans(slice.spans) -@]
    [!- endfor -!]
  [!- endif -!]
[!- endmacro -!]
