[! import "helpers/theme.neoj" as theme !]

<!DOCTYPE html>
<html>
<head>
<style>
body {
  background-color: #333;
  color: goldenrod;
}
</style>
</head>
<body>
<div>ID: [@ page.id @]</div>
[! for section in page.sections !]
[@ theme.output_section(site, page, section) @]
[! endfor !]

<pre>
[@ page.sections|tojson(true) @]
</pre>
</body>
</html>
