  </main>
  <footer class="wrapper-medium flow">
      <h2>Debugging: Neopolitan Source File</h2>
      <pre>[!- autoescape true -!][@- page.source -@][!- endautoescape -!]</pre>
      <div>Page ID: [@ page.id @]</div>
      <pre>[!- autoescape true -!][@- page.sections|tojson(true) -@][!- endautoescape -!]</pre>
  </footer>
</body>
</html>



