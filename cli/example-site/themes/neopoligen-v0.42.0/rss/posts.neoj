[!- import "built-in/macros.neoj" as neo -!]

<rss version="2.0">
<channel>
<title>alanwsmith.com</title>

[!- for page in pages -!]
[!- if page.status == "done" and page.title != none -!]
<item>
<title><![CDATA[[@ page.title @]]]></title>
<link>https://www.alanwsmith.com[@ page.href @]</link>
<pubDate>[@ page.rss_date @]</pubDate>
<guid>https://www.alanwsmith.com[@ page.href @]</guid>
<description><![CDATA[ 

[@ page.output_for_rss @]

]]></description> 
</item>
[!- endif -!]
[!- endfor -!]


[#
<link>https://www.alanwsmith.com[@ page.href @]</link>
<pubDate>[@ page.rss_date @]</pubDate>
<guid>https://www.alanwsmith.com[@ page.href @]</guid>
<description><![CDATA[ 
--- 
[! for section in page.sections !]
[! include section.template_list !]
[! endfor !]
]]></description> 
#]

</channel>
</rss>
