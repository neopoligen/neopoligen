[!- include "macros/current_page_title_as_text.neoj" -!]

[!- macro debug_ping() -!]
<hr />
<h2>Start Debug Ping</h2>
<div>Page ID: [@ page.id @]</div>
<div>Page Dev Test: [@ page.dev_test() @]</div>
<div>Page Dev Test2: [@ page.dev_test2() @]</div>
<h2>End Debug Ping</h2>
<hr />
[!- endmacro -!]




[!- macro ping_site() -!]
<h3>Start Ping Site</h3>
[@ site.get_page_title_from_id(site, page, page.id) @]

---

[@ page.id @]
<h3>End Ping Site</h3>
[!- endmacro -!]





[!- macro debug_page_issues(site, page) -!]
  [!- if page.parsing_issue -!]
    [! include "helpers/issue-0001-parsing/default.neoj" -!]
  [!- elif page.issues -!]
    [!- for issue in page.issues -!]
      [!- include "helpers/issue-0002-page/default.neoj" -!]
    [!- endfor -!]
  [!- endif -!]
[!- endmacro -!]








[#
[!- macro debug_section_tree(site, page, sections) -!]
<ul>
[!- for section in sections -!]
<li>
[@ section.kind @] 
[! if section.spans !]
  [[@ output_spans(site, page, section.spans) @]]
[! else !]
- [@ section.type @]
[! endif !]
[@ debug_section_tree(site, page, section.children) @]
</li>
[! if section.end_section !] 
<li>
[@ section.end_section.kind @]
[@ debug_section_tree(site, page, section.end_section.children) @]
</li>
[! endif !]
[!- endfor -!]
</ul>
[!- endmacro -!]

[!- macro output_css(site, page, template="default.neoj") -!]
[!- for section in page.sections -!]
[!- if section.kind == "css" -!]
[!- include [
  "misc/css-output/" + template,
  "built-in/misc/css-output/" + template
  ]-!]
[!- endif -!]
[!- endfor -!]
[!- endmacro -!]

[!- macro output_end_section(site, page, section) -!]
[!- if section.end_section -!]
[@- output_section(site, page, section.end_section) -@]
[!- endif -!]
[!- endmacro -!]

[!- macro output_just_first_block(site, page, section) -!]
[!- for section in section.children -!]
[!- if loop.first -!]
[@- output_section(site, page, section) -@]
[!- endif -!]
[!- endfor -!]
[!- endmacro -!]

[!- macro output_just_first_block_spans(site, page, section) -!]
[!- for child in section.children -!]
[!- if loop.first -!]
[@- output_spans(site, page, child.spans) -@]
[!- endif -!]
[!- endfor -!]
[!- endmacro -!]

[!- macro output_only_sections(site, page, list_as_string) -!]
[! set list = list_as_string|split|list !]
[!- for section in page.sections -!]
[!- if section.kind in list -!]
[@- output_section(site, page, section) -@]
[!- endif -!]
[!- endfor -!]
[!- endmacro -!]

[!- macro output_scripts(site, page, template="default.neoj") -!]
[!- for section in page.sections -!]
[!- if section.kind == "script" -!]
[!- include [
  "misc/script-output/" + template,
  "built-in/misc/script-output/" + template
  ] -!]
[!- endif -!]
[!- endfor -!]
[!- endmacro -!]

[!- macro output_section(site, page, section) -!]
[!- include section.template_list -!]
[!- endmacro -!]

[!- macro output_section_with_template(site, page, section, template) -!]
[!- include template -!]
[!- endmacro -!]

[!- macro output_sections(site, page, sections) -!]
[!- for section in sections -!]
[@- output_section(site, page, section) -@]
[!- endfor -!]
[!- endmacro -!]

[!- macro output_skip_first_block(site, page, section) -!]
[!- for child in section.children -!]
[!- if not loop.first -!]
[@- output_section(site, page, child) -@]
[!- endif -!]
[!- endfor -!]
[!- endmacro -!]

[!- macro output_span(site, page, span) -!]
[!- if span.kind -!]
[!- include [
  "spans/" + span.kind + "/default.neoj", 
  "spans/" + span.type + "/default.neoj",
  "spans/plain-text/default.neoj",  
  "built-in/spans/" + span.kind + "/default.neoj", 
  "built-in/spans/" + span.type + "/default.neoj",
  "built-in/spans/plain-text/default.neoj"
  ] -!]
[!- else -!]
[!- include [
  "spans/" + span.type + "/default.neoj", 
  "spans/plain-text/default.neoj", 
  "built-in/spans/" + span.type + "/default.neoj", 
  "built-in/spans/plain-text/default.neoj"
  ] -!]
[!- endif -!]
[!- endmacro -!]

[!- macro output_spans(site, page, spans) -!]
[!- for span in spans -!]
[@- output_span(site, page, span) -@]
[!- endfor -!]
[!- endmacro -!]

#]