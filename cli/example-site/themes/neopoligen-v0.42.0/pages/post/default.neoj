[!- extends "wrappers/one-column.neoj" -!]
[!- import "built-in/macros.neoj" as neo -!]

[!- block body_main -!]
  [@- neo.output_only_sections(["title", "subtitle", "forward"]) -@]
  [@- neo.output_all_sections_except(["title", "subtitle", "forward", "endnote", "footnote", "ref"]) -@]
  [!- include "includes/endnotes.neoj" -!]
  [!- include "includes/footnotes.neoj" -!]
  [!- include "includes/refs.neoj" -!]
[!- endblock -!]

