[@- '' -@]

<code class="code-span color-alt-1-80" [@- site.get_span_attrs(span) -@]>
  [!- autoescape false -!]
    [!- if span.flags|length > 0 -!]
    [@- highlight_span(span.text, span.flags[0]) -@]
    [!- else -!]
    [@- highlight_span(span.text, "txt") -@]
    [!- endif -!]
  [!- endautoescape -!]
</code>

[@- '' -@]
