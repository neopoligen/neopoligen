[!- import "helpers/theme.neoj" as theme -!]
[! if span.type() == "tlink" !]
THIS IS TLINK
[! else !]
<[@ span.type() @]>
[!- for child in span.children() -!]
[@- theme.output_span(site, page_id, child) -@]
[!- endfor -!]</[@ span.type() @]>
[! endif !]




[#
<[@ span.type @] 
[! if span.classes[0] !] class="[! for c in span.classes !][@ c @][! endfor !]"
[! endif !]
>[!- for child in span.children -!]
[@- theme.output_span(site, page_id, child) -@]
[!- endfor -!]</[@ span.type @]>
#]
